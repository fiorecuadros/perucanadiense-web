# ============================================================================
# .env de PRODUCCIÓN (cPanel) — IESPP Peruano Canadiense
#
# Plantilla sin credenciales. Cópiela como `.env` en la raíz de la aplicación
# Node (junto a server.js) y complete los valores. NUNCA suba el `.env` real
# al repositorio.
# ============================================================================

# --- Servidor ---------------------------------------------------------------
# SIN línea PORT: Passenger asigna el puerto. Si la fija, la app no arranca.
NODE_ENV=production

# Orígenes que pueden llamar al API desde un navegador.
CORS_ORIGINS=https://pcanadiense.edu.pe,https://www.pcanadiense.edu.pe

# --- Base de datos ----------------------------------------------------------
# cPanel antepone el nombre de la cuenta a la base y al usuario.
# Cópielos tal cual salen en "MySQL Databases".
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Sesión -----------------------------------------------------------------
# Cadena larga y aleatoria, distinta de la de desarrollo. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas del panel.
JWT_SECRET=
JWT_EXPIRA=8h

# --- Archivos subidos -------------------------------------------------------
# FUERA del Application root y FUERA de public_html: los adjuntos de mesa de
# partes llevan el DNI del ciudadano. Créela y déjela en 700.
ALMACEN_DIR=/home/USUARIO/almacen_pcanadiense
MAX_MB_IMAGEN=5
MAX_MB_PDF=15

# --- Correo -----------------------------------------------------------------
# Sin la clave de la casilla, deje MAIL_HABILITADO=false: el trámite se guarda
# igual; no se envía acuse ni aviso al solicitante.
MAIL_HABILITADO=false
MAIL_HOST=mail.pcanadiense.edu.pe
MAIL_PORT=465
MAIL_SEGURO=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_REMITENTE=
MAIL_RECEPTOR=

# --- Primer administrador ---------------------------------------------------
# Solo lo lee `npm run crear-admin`. BORRE ADMIN_CLAVE en cuanto la cuenta
# exista: mientras esté aquí, es una contraseña en texto plano en el servidor.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del portal
ADMIN_CLAVE=
